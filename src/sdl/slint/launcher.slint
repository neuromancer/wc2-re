import {
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    Palette,
    ScrollView,
    Slider,
    TabWidget,
    VerticalBox
} from "std-widgets.slint";
import { ControlsView, InputBinding, InputRow, PadControl, PadDevice } from "controls.slint";
import { CalibrationView, CalibrationStep, CalibrationMessage, StickView, DeadZoneText } from "calibration.slint";
export { DeadZoneText, PadControl, CalibrationStep, CalibrationMessage, StickView }

export enum LauncherMessage {
    choose-directory, path-too-long, not-directory, choose-data-directory,
    missing-cockpit, unreadable-cockpit, missing-game-file, unknown-cockpit,
    needs-streams, missing-stream-file, picker-failed, picker-init-failed,
    cannot-resolve-directory, cannot-open-directory, dos, kilrathi-saga
}

// One window holds the launcher, after wc1-re's: its settings and the controls
// in tabs above the buttons that start the game, and the joystick
// calibration as a page in their place. That suits gamescope (Steam's Game
// Mode), where a single window fills the screen.
export component LauncherWindow inherits Window {
    title: root.page == 2 ? calibration-view.title : "Wing Commander II";
    preferred-width: 800px;
    preferred-height: 660px;
    min-width: 480px;
    min-height: 360px;
    background: Palette.background;

    // 0 the tabs, 2 the joystick calibration.
    in-out property <int> page: 0;
    // The tab shown: 0 the installation, 1 the options, 2 the joystick, 3 the
    // keyboard and mouse.
    in-out property <int> settings-tab: 0;

    in property <image> title-artwork;
    in-out property <string> game-directory;
    in property <[string]> installations;
    in property <bool> has-installations;
    in-out property <int> installation-index;
    in-out property <bool> start-fullscreen;
    in-out property <int> language-index;
    // A DOS install patched with the German translation keeps its own text.
    in property <bool> german-text: false;
    out property <[string]> language-choices: root.german-text
        ? ["German"]
        : ["English", "Español", "Polski"];
    // The music and the sound effects the game plays (SdlLauncherMusic,
    // SdlLauncherSound), each on its own device: a DOS install offers the
    // AdLib and the MT-32, a Kilrathi Saga install also its digital ones.
    in property <bool> dos-data: false;
    in property <bool> music-available: false;
    in-out property <int> music-device;
    in-out property <int> sound-device;
    // The choices shown for the devices, which depend on the installation.
    in-out property <int> music-index;
    in-out property <int> sound-index;
    out property <[string]> music-choices: root.dos-data
        ? [@tr("AdLib"), @tr("Roland MT-32")]
        : [@tr("Digital"), @tr("AdLib"), @tr("Roland MT-32")];
    out property <bool> mt32-chosen: root.music-device == 2 || root.sound-device == 2;
    in property <bool> mt32-roms-set: false;
    in property <bool> mt32-ready: false;
    // libmt32emu's description of the ROMs, or why they cannot play.
    in property <string> mt32-detail;
    in-out property <bool> enhanced-renderer;
    in-out property <bool> ega-dither;
    in-out property <bool> hires-hud-fonts;
    in-out property <bool> frame-interpolation;
    in-out property <bool> balanced-difficulty;
    in-out property <bool> cheat-mode;
    // Spaceflight's frame rate, which the game's speed follows, in half frames
    // a second (SdlLauncherFlightFps): Normal 40, the Kilrathi Saga's 20 FPS,
    // or Slow 30, its WC2's own pace. A rate set in flight with [ and ] is
    // offered as Custom.
    in-out property <int> flight-fps-halves: 40;
    in property <int> custom-flight-fps-halves: 0;
    in property <string> custom-flight-fps;
    out property <[string]> speed-choices: root.custom-flight-fps-halves > 0
        ? [@tr("Normal (20 FPS)"), @tr("Slow (15 FPS)"), @tr("Custom ({} FPS)", root.custom-flight-fps)]
        : [@tr("Normal (20 FPS)"), @tr("Slow (15 FPS)")];
    in-out property <bool> joystick-rumble;
    in-out property <int> joystick-mode-index;
    in-out property <int> joystick-source-index;
    in-out property <int> joystick-axes-index;
    // Percent of travel (src/sdl/joystick_calibration.h).
    in-out property <float> joystick-dead-zone: 22;
    // The first entry is Automatic, followed by the detected devices.
    in property <[string]> joystick-devices;
    in-out property <int> joystick-device-index;
    callback joystick-device-chosen(int);

    in property <bool> path-valid: false;
    in property <bool> has-so1: false;
    in property <bool> has-so2: false;
    in property <bool> picker-error: false;
    in property <LauncherMessage> status;
    in property <string> status-detail;
    out property <string> status-text: message-text(root.status, root.status-detail);
    out property <string> installation-prompt: root.has-installations
        ? @tr("Select game data…") : @tr("No game data found — add a path");
    out property <string> automatic-joystick: @tr("Automatic");
    out property <string> unnamed-joystick: @tr("Unnamed joystick");
    // The bindings cover WC2's DOS and Kilrathi Saga data.
    out property <bool> controls-available: root.path-valid
        && (root.status == LauncherMessage.dos || root.status == LauncherMessage.kilrathi-saga);
    // j.cal lives in WC2's GAMEDAT.
    out property <bool> calibration-available: root.path-valid;

    public pure function message-text(message: LauncherMessage, detail: string) -> string {
        if message == LauncherMessage.choose-directory { return @tr("Choose a Wing Commander II directory."); }
        if message == LauncherMessage.path-too-long { return @tr("The directory path is too long."); }
        if message == LauncherMessage.not-directory { return @tr("The selected path is not a directory."); }
        if message == LauncherMessage.choose-data-directory { return @tr("Choose a WC2 directory containing GAMEDAT."); }
        if message == LauncherMessage.missing-cockpit { return @tr("GAMEDAT/COCKPIT.VGA is missing."); }
        if message == LauncherMessage.unreadable-cockpit { return @tr("GAMEDAT/COCKPIT.VGA is unreadable or too small to identify."); }
        if message == LauncherMessage.missing-game-file { return @tr("GAMEDAT/{} is missing or unreadable. Select a WC2 installation.", detail); }
        if message == LauncherMessage.unknown-cockpit { return @tr("GAMEDAT/COCKPIT.VGA is not recognized WC2 data."); }
        if message == LauncherMessage.needs-streams { return @tr("Kilrathi Saga data needs a sibling STREAMS directory."); }
        if message == LauncherMessage.missing-stream-file { return @tr("STREAMS/{} is missing or unreadable.", detail); }
        if message == LauncherMessage.picker-failed { return @tr("The folder picker failed") + (detail == "" ? "" : ": " + detail); }
        if message == LauncherMessage.picker-init-failed { return @tr("The folder picker could not be initialized") + (detail == "" ? "" : ": " + detail); }
        if message == LauncherMessage.cannot-resolve-directory { return @tr("Cannot resolve the game directory") + (detail == "" ? "" : ": " + detail); }
        if message == LauncherMessage.cannot-open-directory { return @tr("Cannot open the game directory") + (detail == "" ? "" : ": " + detail); }
        return "";
    }

    callback browse-requested();
    callback installation-selected(int);
    callback language-selected(int);
    callback music-selected(int);
    callback sound-selected(int);
    callback mt32-browse-requested();
    callback launch-requested(int);
    callback cancel-requested();
    // The keyboard and mouse tab opened; the launcher gives it the saved
    // bindings.
    callback controls-requested();
    callback calibration-requested();

    changed settings-tab => {
        if root.settings-tab == 3 {
            root.controls-requested();
        }
    }

    // The keyboard and mouse tab (controls.slint) and its bindings.
    in property <bool> apple-keys;
    out property <[InputRow]> keyboard-rows: keys-view.keyboard-rows;
    in-out property <[[InputBinding]]> keyboard-bindings <=> keys-view.keyboard-bindings;
    out property <int> max-bindings: keys-view.max-bindings;
    callback binding-changed <=> keys-view.binding-changed;
    callback binding-removed <=> keys-view.binding-removed;
    callback bindings-reset <=> keys-view.bindings-reset;
    // The game controller's label for a control, as the Joystick tab shows it
    // (bin/checkLauncher.cpp).
    public pure function pad-binding(control: PadControl) -> string {
        return pad-view.pad-binding(control);
    }

    // The Custom joystick mode's bindings (controls.slint); the launcher
    // fills them in when the mode is first chosen.
    in property <[int]> pad-codes;
    in property <[int]> steam-deck-codes;
    callback pad-code-changed <=> pad-view.pad-code-changed;
    callback pad-reset <=> pad-view.pad-reset;
    callback custom-pad-requested();

    changed joystick-mode-index => {
        if root.joystick-mode-index == 3 {
            root.custom-pad-requested();
        }
    }

    // The Joystick tab reads the joysticks while it shows (launcher.cpp's
    // PadSession) and shows the one in pad-slot; a press there opens the
    // Custom mode's chooser for it.
    in property <PadDevice> pad-device;
    in property <[bool]> pad-held;
    in property <[float]> pad-axis-values;
    in property <[int]> pad-axis-kinds;
    in property <[string]> pad-devices: ["", ""];
    in-out property <int> pad-slot <=> pad-view.pad-slot;
    callback pad-slot-chosen <=> pad-view.pad-slot-chosen;
    callback pad-live-changed(bool);
    callback pad-pressed(int);
    pad-pressed(control) => {
        pad-view.press-control(control);
    }
    property <bool> pad-live: root.page == 0 && root.settings-tab == 2;
    changed pad-live => {
        root.pad-live-changed(root.pad-live);
    }

    // The calibration page (calibration.slint); it shares the dead zone.
    in property <[string]> calibration-devices: ["", ""];
    in-out property <int> calibration-device <=> calibration-view.device-index;
    in property <bool> calibration-connected;
    in property <StickView> calibration-stick: {
        x: 32768, y: 32768, left: 16, right: 65518, top: 16, bottom: 65518,
        centre-x: 32767, centre-y: 32767, zone-left: 25489, zone-right: 40045,
        zone-top: 25489, zone-bottom: 40045, step-x: 0, step-y: 0
    };
    in property <CalibrationStep> calibration-step;
    // j.cal holds a calibration for the chosen joystick.
    in property <bool> calibration-stored;
    in property <CalibrationMessage> calibration-message;
    in property <string> calibration-message-detail;
    callback calibration-device-selected <=> calibration-view.device-selected;
    callback calibration-start <=> calibration-view.calibrate;
    callback calibration-record <=> calibration-view.record;
    callback calibration-cancel <=> calibration-view.cancel;
    callback calibration-reset <=> calibration-view.reset;
    // Back to the settings; the launcher stops reading the joysticks.
    callback calibration-closed <=> calibration-view.back-requested;

    // Each page scrolls when the window is smaller than it is. A page fills
    // the scrolled area from its corner; with a size alone it would be
    // centred in the visible part instead.
    settings-scroll := ScrollView {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: root.page == 0;
        content-width: max(self.visible-width, settings.min-width);
        content-height: max(self.visible-height, settings.min-height);

        // The settings in tabs, above the buttons that start the game,
        // which every tab shares.
        settings := VerticalBox {
            x: 0px;
            y: 0px;
            width: settings-scroll.content-width;
            height: settings-scroll.content-height;
            padding: 14px;
            spacing: 10px;

            Rectangle {
                height: 64px;
                vertical-stretch: 0;
                background: #000018;
                border-radius: 6px;

                Image {
                    x: 12px;
                    y: 5px;
                    width: parent.width - 24px;
                    height: parent.height - 10px;
                    source: root.title-artwork;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
            }

            TabWidget {
                vertical-stretch: 1;
                current-index <=> root.settings-tab;

                Tab {
                    title: @tr("Installation");

                    VerticalBox {
                        alignment: start;

                        GroupBox {
                            title: @tr("Game installation");
                            vertical-stretch: 0;

                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 34px;

                                    ComboBox {
                                        horizontal-stretch: 1;
                                        enabled: root.has-installations;
                                        model: root.installations;
                                        current-index <=> root.installation-index;
                                        selected(_) => {
                                            root.installation-selected(self.current-index);
                                        }
                                    }

                                    Button {
                                        text: @tr("Add path…");
                                        clicked => {
                                            root.browse-requested();
                                        }
                                    }
                                }

                                GridLayout {
                                    spacing: 8px;

                                    Row {
                                        Text {
                                            text: @tr("Language");
                                            vertical-alignment: center;
                                        }
                                        ComboBox {
                                            colspan: 2;
                                            horizontal-stretch: 1;
                                            model: root.language-choices;
                                            current-index: root.language-index;
                                            selected(_) => {
                                                root.language-selected(self.current-index);
                                            }
                                        }
                                    }

                                    Row {
                                        Text {
                                            text: @tr("Music");
                                            vertical-alignment: center;
                                        }
                                        ComboBox {
                                            colspan: 2;
                                            horizontal-stretch: 1;
                                            enabled: root.music-available;
                                            model: root.music-choices;
                                            current-index <=> root.music-index;
                                            selected(_) => {
                                                root.music-selected(self.current-index);
                                            }
                                        }
                                    }

                                    Row {
                                        Text {
                                            text: @tr("Sound");
                                            vertical-alignment: center;
                                        }
                                        // The same devices play the effects.
                                        ComboBox {
                                            colspan: 2;
                                            horizontal-stretch: 1;
                                            enabled: root.music-available;
                                            model: root.music-choices;
                                            current-index <=> root.sound-index;
                                            selected(_) => {
                                                root.sound-selected(self.current-index);
                                            }
                                        }
                                    }
                                }

                                // The MT-32's ROMs, once the music or the sound effects use it.
                                if root.music-available && root.mt32-chosen : HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;

                                    Text {
                                        text: root.mt32-ready ? "●" : "!";
                                        color: root.mt32-ready ? #2e7d32 : #b45f06;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.mt32-ready
                                            ? @tr("MT-32: {}", root.mt32-detail)
                                            : !root.mt32-roms-set
                                            ? @tr("Choose the folder with your MT-32 or CM-32L ROMs; until then the AdLib plays instead.")
                                            : @tr("The AdLib plays instead: {}", root.mt32-detail);
                                        color: root.mt32-ready ? Palette.foreground : #b45f06;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }

                                    Button {
                                        text: @tr("MT-32 ROMs…");
                                        clicked => {
                                            root.mt32-browse-requested();
                                        }
                                    }
                                }

                                if root.picker-error || !root.path-valid : HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;

                                    Text {
                                        text: root.picker-error ? "!" : "●";
                                        color: root.picker-error ? #b3261e : #b45f06;
                                        font-size: 14px;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.status-text;
                                        color: root.picker-error ? #b3261e : #b45f06;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Options");

                    VerticalBox {
                        alignment: start;

                        HorizontalLayout {
                            spacing: 18px;
                            vertical-stretch: 0;

                            GroupBox {
                                title: @tr("Graphics");
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    CheckBox {
                                        height: 26px;
                                        text: @tr("Start in fullscreen");
                                        checked <=> root.start-fullscreen;
                                    }

                                    CheckBox {
                                        height: 26px;
                                        text: @tr("Enhanced OpenGL");
                                        checked <=> root.enhanced-renderer;
                                    }

                                    CheckBox {
                                        height: 26px;
                                        text: @tr("EGA 16-colour dithering");
                                        checked <=> root.ega-dither;
                                    }

                                    CheckBox {
                                        text: @tr("Hi-res HUD fonts");
                                        enabled: root.enhanced-renderer;
                                        checked <=> root.hires-hud-fonts;
                                    }

                                    CheckBox {
                                        height: 26px;
                                        text: @tr("Smooth spaceflight");
                                        checked <=> root.frame-interpolation;
                                    }
                                }
                            }

                            GroupBox {
                                title: @tr("Gameplay");
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    CheckBox {
                                        height: 26px;
                                        text: @tr("Balanced difficulty");
                                        checked <=> root.balanced-difficulty;
                                    }

                                    CheckBox {
                                        height: 26px;
                                        text: @tr("Cheat mode");
                                        checked <=> root.cheat-mode;
                                    }

                                    Text {
                                        text: @tr("Invulnerability and no collisions");
                                        color: Palette.foreground;
                                        opacity: 0.65;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-stretch: 0;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Text {
                                            text: @tr("Speed");
                                            vertical-alignment: center;
                                        }

                                        ComboBox {
                                            horizontal-stretch: 1;
                                            model: root.speed-choices;
                                            current-index: root.flight-fps-halves == 40 ? 0
                                                : root.flight-fps-halves == 30 ? 1 : 2;
                                            selected(_) => {
                                                root.flight-fps-halves = self.current-index == 0 ? 40
                                                    : self.current-index == 1 ? 30
                                                    : root.custom-flight-fps-halves;
                                            }
                                        }
                                    }

                                    Text {
                                        text: @tr("In flight, [ and ] (the two keys right of P) slow the game down or speed it up.");
                                        color: Palette.foreground;
                                        opacity: 0.65;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-stretch: 0;
                                    }
                                }
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Joystick");

                    VerticalBox {
                        // WC2 lets the player choose which joystick flies.
                        if root.joystick-devices.length > 2 : HorizontalLayout {
                            spacing: 8px;
                            height: 34px;
                            vertical-stretch: 0;

                            Text {
                                text: @tr("Device");
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }

                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.joystick-devices;
                                current-index <=> root.joystick-device-index;
                                selected => { root.joystick-device-chosen(root.joystick-device-index); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 34px;
                            vertical-stretch: 0;

                            Text {
                                text: @tr("Control mode");
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }

                            ComboBox {
                                horizontal-stretch: 3;
                                model: [
                                    @tr("Original — two axes / two buttons"),
                                    @tr("WCAT — four buttons / two axes"),
                                    @tr("WCAT — four buttons / four axes"),
                                    @tr("Custom — your own bindings"),
                                    @tr("Steam Deck")
                                ];
                                current-index <=> root.joystick-mode-index;
                            }

                            Rectangle { width: 6px; }

                            if root.joystick-mode-index < 3: Text {
                                text: @tr("Axis layout");
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }

                            // Custom mode binds each axis individually.
                            if root.joystick-mode-index < 3: ComboBox {
                                horizontal-stretch: 2;
                                enabled: root.joystick-mode-index == 2;
                                model: [
                                    @tr("Twin-stick roll"),
                                    @tr("Twin-stick yaw"),
                                    @tr("HOTAS yaw"),
                                    @tr("HOTAS roll"),
                                    @tr("Linear throttle"),
                                    @tr("Rudder yaw"),
                                    @tr("Rudder roll")
                                ];
                                current-index <=> root.joystick-axes-index;
                            }
                            if root.joystick-mode-index == 3: Text {
                                text: @tr("Source");
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }
                            if root.joystick-mode-index == 3: ComboBox {
                                horizontal-stretch: 2;
                                model: [@tr("Automatic"), @tr("Gamepad"), @tr("Steam Deck"), @tr("ControlSource" => "Joystick")];
                                current-index <=> root.joystick-source-index;
                            }
                            if root.joystick-mode-index == 4: Text {
                                horizontal-stretch: 2;
                                text: @tr("Left: roll + speed · Right: yaw + pitch");
                                wrap: word-wrap;
                                vertical-alignment: center;
                                color: Palette.foreground;
                                font-size: 12px;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 34px;
                            vertical-stretch: 0;

                            Text {
                                text: @tr("Dead zone");
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }

                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 33;
                                value <=> root.joystick-dead-zone;
                                changed(value) => {
                                    self.value = Math.round(value);
                                }
                            }

                            Text {
                                min-width: 110px;
                                text: DeadZoneText.describe(Math.round(root.joystick-dead-zone));
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }

                            CheckBox {
                                text: @tr("Rumble");
                                checked <=> root.joystick-rumble;
                            }

                            Button {
                                text: @tr("Calibrate…");
                                enabled: root.calibration-available;
                                clicked => {
                                    root.calibration-requested();
                                }
                            }
                        }

                        // The game controller's bindings for these settings;
                        // the view's size limits reach the tabs through this.
                        Rectangle {
                            min-width: pad-view.min-width;
                            min-height: pad-view.min-height;

                            pad-view := ControlsView {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                visible: root.controls-available;
                                page: 0;
                                joystick-mode: root.joystick-mode-index;
                                joystick-source: root.joystick-source-index;
                                joystick-axes: root.joystick-axes-index;
                                pad-codes: root.joystick-mode-index == 4 ? root.steam-deck-codes : root.pad-codes;
                                pad-device: root.pad-device;
                                pad-held: root.pad-held;
                                pad-axis-values: root.pad-axis-values;
                                pad-axis-kinds: root.pad-axis-kinds;
                                pad-devices: root.pad-devices;
                                // Its tooltips name the keys of the keyboard tab.
                                keyboard-bindings: keys-view.keyboard-bindings;
                            }

                            if !root.controls-available: Text {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                text: @tr("The controls are shown for WC2's DOS and Kilrathi Saga installations.");
                                wrap: word-wrap;
                                color: Palette.foreground;
                                opacity: 0.75;
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Keyboard and mouse");

                    VerticalBox {
                        Rectangle {
                            min-width: keys-view.min-width;
                            min-height: keys-view.min-height;

                            keys-view := ControlsView {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                visible: root.controls-available;
                                page: 1;
                                apple-keys: root.apple-keys;
                            }

                            if !root.controls-available: Text {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                text: @tr("The controls are shown for WC2's DOS and Kilrathi Saga installations.");
                                wrap: word-wrap;
                                color: Palette.foreground;
                                opacity: 0.75;
                            }
                        }
                    }
                }
            }

            // Every tab shares the game's start buttons.
            HorizontalLayout {
                spacing: 8px;
                height: 34px;
                vertical-stretch: 0;

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: @tr("Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }

                Button {
                    text: @tr("Start WC2");
                    enabled: root.path-valid;
                    primary: true;
                    clicked => {
                        root.launch-requested(0);
                    }
                }

                if root.has-so1 : Button {
                    text: @tr("Start SO1");
                    clicked => {
                        root.launch-requested(1);
                    }
                }

                if root.has-so2 : Button {
                    text: @tr("Start SO2");
                    clicked => {
                        root.launch-requested(2);
                    }
                }
            }
        }
    }

    calibration-scroll := ScrollView {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: root.page == 2;
        content-width: max(self.visible-width, calibration-view.min-width);
        content-height: max(self.visible-height, calibration-view.min-height);

        // At most 640px wide, in the middle.
        calibration-view := CalibrationView {
            x: max(0px, (calibration-scroll.content-width - self.width) / 2);
            y: 0px;
            width: min(calibration-scroll.content-width, 640px);
            height: calibration-scroll.content-height;
            device-names: root.calibration-devices;
            connected: root.calibration-connected;
            view: root.calibration-stick;
            step: root.calibration-step;
            calibrated: root.calibration-stored;
            message: root.calibration-message;
            message-detail: root.calibration-message-detail;
            dead-zone <=> root.joystick-dead-zone;
        }
    }
}
