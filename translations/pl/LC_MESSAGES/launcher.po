msgid "Speed"
msgstr "Prędkość"

msgctxt "ControlsView"
msgid "Throttle position"
msgstr "Położenie przepustnicy"

msgctxt "ControlsView"
msgid "{} (analog)"
msgstr "{} (analogowo)"

msgctxt "ControlsView"
msgid "{}, reversed"
msgstr "{}, odwrócone"

msgctxt "ControlsView"
msgid "Fires while held."
msgstr "Strzela, gdy przycisk jest wciśnięty."

msgctxt "ControlsView"
msgid "Burns while held."
msgstr "Włącza dopalacz, gdy przycisk jest wciśnięty."

msgctxt "ControlsView"
msgid "Turns at the full rate while held, with a turn button or key."
msgstr "Skręca z pełną szybkością, gdy przycisk jest wciśnięty razem z przyciskiem lub klawiszem skrętu."

msgctxt "ControlsView"
msgid "Changes speed while held."
msgstr "Zmienia prędkość, gdy przycisk jest wciśnięty."

msgctxt "ControlsView"
msgid "Steers while held."
msgstr "Steruje, gdy przycisk jest wciśnięty."

msgctxt "ControlsView"
msgid "Once per press."
msgstr "Raz na naciśnięcie."

msgctxt "ControlsView"
msgid "Right dives and left climbs."
msgstr "W prawo opuszcza nos, a w lewo go podnosi."

msgctxt "ControlsView"
msgid "Up dives and down climbs, as with the original joystick."
msgstr "W górę opuszcza nos, a w dół go podnosi, jak oryginalny joystick."

msgctxt "ControlsView"
msgid "Right turns right and left turns left."
msgstr "W prawo skręca w prawo, a w lewo skręca w lewo."

msgctxt "ControlsView"
msgid "Up turns right and down turns left."
msgstr "W górę skręca w prawo, a w dół skręca w lewo."

msgctxt "ControlsView"
msgid "Right rolls right and left rolls left."
msgstr "W prawo przechyla w prawo, a w lewo przechyla w lewo."

msgctxt "ControlsView"
msgid "Up rolls right and down rolls left."
msgstr "W górę przechyla w prawo, a w dół przechyla w lewo."

msgctxt "ControlsView"
msgid "Right speeds up and left slows down, faster the further it goes."
msgstr "W prawo przyspiesza, a w lewo zwalnia; większe wychylenie przyspiesza zmianę."

msgctxt "ControlsView"
msgid "Up speeds up and down slows down, faster the further it goes."
msgstr "W górę przyspiesza, a w dół zwalnia; większe wychylenie przyspiesza zmianę."

msgctxt "ControlsView"
msgid "Sets the speed like a throttle lever: fully right is full speed and fully left stops."
msgstr "Ustawia prędkość jak dźwignia przepustnicy: skrajnie w prawo daje pełną prędkość, a skrajnie w lewo zatrzymuje."

msgctxt "ControlsView"
msgid "Sets the speed like a throttle lever: fully up is full speed and fully down stops."
msgstr "Ustawia prędkość jak dźwignia przepustnicy: skrajnie w górę daje pełną prędkość, a skrajnie w dół zatrzymuje."

msgctxt "ControlsView"
msgid "Keyboard and mouse: {}."
msgstr "Klawiatura i mysz: {}."

msgctxt "ControlsView"
msgid "The input does nothing in flight."
msgstr "Ten element sterujący nie działa w locie."

msgctxt "ControlsView"
msgid "Steps through the front, left, right, rear and chase views."
msgstr "Przełącza kolejno widok z przodu, z lewej, z prawej, z tyłu i zza statku."

msgctxt "ControlsView"
msgid "While held, what yaws rolls instead and what pitches changes speed, as the original joystick's second button does."
msgstr "Gdy przycisk jest wciśnięty, odchylenie zmienia się w przechylenie, a pochylenie zmienia prędkość, jak drugi przycisk oryginalnego joysticka."

msgctxt "ControlsView"
msgid "{}, faster the further the trigger is pressed."
msgstr "{}; mocniejsze wciśnięcie spustu przyspiesza zmianę."

msgctxt "ControlsView"
msgid "Sets the speed like a throttle lever: fully pressed is full speed and released stops."
msgstr "Ustawia prędkość jak dźwignia przepustnicy: pełne wciśnięcie daje pełną prędkość, a zwolnienie zatrzymuje."

msgctxt "ControlsView"
msgid "Reversed: the other way round."
msgstr "Odwrócone: w przeciwnym kierunku."

msgctxt "ControlsView"
msgid "To rebind it, choose Custom in Control mode."
msgstr "Aby zmienić przypisanie, wybierz tryb Własny w polu Tryb sterowania."

