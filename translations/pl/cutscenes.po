msgctxt "cutscene/INCIDENT.S00/packet/50/text/0"
msgid "wc2:82fff89a0a6ac1da"
msgstr "Zebraliśmy się dziś, by pożegnać..."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/1"
msgid "wc2:46692679b97ed481"
msgstr "---jednego z najlepszych pilotów Concordii."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/2"
msgid "wc2:9cabefa559d88a9a"
msgstr "Mariko Tanaka była jedną z moich najbliższych przyjaciółek."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/3"
msgid "wc2:aa0ae00b7ee0bb7f"
msgstr "Żyła według kodeksu honorowego i według niego też umarła."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/4"
msgid "wc2:b9703a5ff798f28c"
msgstr "---jednego z najlepszych pilotów Konfederacji."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/5"
msgid "wc2:f08cd2788226f499"
msgstr "Nie znałam kapitan Norwood zbyt dobrze..."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/6"
msgid "wc2:08ee92e16de454fc"
msgstr "...ale była oddanym i wykwalifikowanym pilotem."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/7"
msgid "wc2:207df05345d9c11d"
msgstr "Jej śmierć to strata dla Konfederacji."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/8"
msgid "wc2:e5d165d98db580f7"
msgstr "Nasza przyjaciółka nie jest jedynym pilotem Konfederacji, który zginął na służbie."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/9"
msgid "wc2:26ace28a2867f449"
msgstr "Śmierć to strach, z którym każdy z nas musi się mierzyć każdego dnia na tym okręcie."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/10"
msgid "wc2:219332e754d6299a"
msgstr "Ale nie możemy zapominać, dlaczego tu jesteśmy i o co walczymy."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/11"
msgid "wc2:94c6b7b402a2391e"
msgstr "Wielu pilotów oddało życie za naszą sprawę---"

msgctxt "cutscene/INCIDENT.S00/packet/50/text/12"
msgid "wc2:0c5b6df19486f9e3"
msgstr "---a my będziemy kontynuować walkę ku ich pamięci."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/13"
msgid "wc2:0b0a24d2d1d12ed9 {last_name}"
msgstr "---kapitana {last_name} z Ochrony Wewnątrzukładowej."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/14"
msgid "wc2:8d604efcbbb6f61f {last_name}"
msgstr "Większość z was znała {last_name} tylko z reputacji..."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/15"
msgid "wc2:6686cb1d737e6eb8"
msgstr "...którą niesłusznie zniszczono dziesięć lat temu."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/16"
msgid "wc2:4e694814e53ad89e"
msgstr "Choć nigdy nie udowodniono, że był odpowiedzialny---"

msgctxt "cutscene/INCIDENT.S00/packet/50/text/17"
msgid "wc2:4c329d13d3a5b4ef"
msgstr "---za zniszczenie TCS Tiger's Claw---"

msgctxt "cutscene/INCIDENT.S00/packet/50/text/18"
msgid "wc2:49198df392beef29"
msgstr "---ta katastrofa zakończyła jego błyskotliwą karierę we Flocie."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/19"
msgid "wc2:d6137a37c238ba7c {last_name}"
msgstr "Spirit, Jazz, Doomsday i ja służyliśmy z {last_name} na pokładzie Tiger's Claw---"

msgctxt "cutscene/INCIDENT.S00/packet/50/text/20"
msgid "wc2:6340c923dfbd5bf4"
msgstr "---i znamy jego prawdziwe oddanie naszej sprawie."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/21"
msgid "wc2:731f7f705270c3e3 {callsign}"
msgstr "{callsign} był doskonałym pilotem i prawdziwym przyjacielem."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/22"
msgid "wc2:c5d6e564f9f58766"
msgstr "A teraz musimy się z nim pożegnać..."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/23"
msgid "wc2:0b0a24d2d1d12ed9 {last_name}"
msgstr "---kapitana {last_name} z Ochrony Wewnątrzukładowej."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/24"
msgid "wc2:0f323e44e004b873 {callsign}"
msgstr "W zaledwie kilku misjach {callsign} udowodnił swoje umiejętności---"

msgctxt "cutscene/INCIDENT.S00/packet/50/text/25"
msgid "wc2:ac25e079daf1a96d"
msgstr "---pomagając pilotom Concordii w ich misjach."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/26"
msgid "wc2:a43000840956256a"
msgstr "Teraz musimy kontynuować walkę bez niego."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/27"
msgid "wc2:0b0a24d2d1d12ed9 {last_name}"
msgstr "---kapitana {last_name} z Ochrony Wewnątrzukładowej."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/28"
msgid "wc2:4ab937dd52bb282c {last_name}"
msgstr "Wszyscy znacie dokonania {last_name}---"

msgctxt "cutscene/INCIDENT.S00/packet/50/text/29"
msgid "wc2:31f1ca1d7685f076"
msgstr "---i to, jak pomógł nam w naszej kampanii w tym sektorze."

msgctxt "cutscene/INCIDENT.S00/packet/50/text/30"
msgid "wc2:a43000840956256a"
msgstr "Teraz musimy kontynuować walkę bez niego."

msgctxt "cutscene/INCIDENT.S00/packet/78/text/0"
msgid "wc2:d4b801e70294b8aa"
msgstr "TCS Tiger's Claw.\nNa podejściu do ataku na K'Tithrak Mang,\nKwaterę Sektora Kilrathi."

